{
  "cli": {
    "version": ">= 19.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "preview",
        "EXPO_PUBLIC_DEV_SKIP_ONBOARDING": "false",
        "EXPO_PUBLIC_SKIP_EMAIL_VERIFICATION": "false",
        "EXPO_PUBLIC_API_URL": "https://api.appquilax.com",
        "EXPO_PUBLIC_WALLET_URL": "https://gestion.appquilax.com",
        "EXPO_PUBLIC_SOCKET_URL": "https://api.appquilax.com"
      }
    },
    "testflight": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_DEV_SKIP_ONBOARDING": "false",
        "EXPO_PUBLIC_SKIP_EMAIL_VERIFICATION": "false",
        "EXPO_PUBLIC_API_URL": "https://api.appquilax.com",
        "EXPO_PUBLIC_WALLET_URL": "https://gestion.appquilax.com",
        "EXPO_PUBLIC_SOCKET_URL": "https://api.appquilax.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_DEV_SKIP_ONBOARDING": "false",
        "EXPO_PUBLIC_SKIP_EMAIL_VERIFICATION": "false",
        "EXPO_PUBLIC_API_URL": "https://api.appquilax.com",
        "EXPO_PUBLIC_WALLET_URL": "https://gestion.appquilax.com",
        "EXPO_PUBLIC_SOCKET_URL": "https://api.appquilax.com"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "ascAppId": "6812836055"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6812836055"
      }
    }
  }
}
