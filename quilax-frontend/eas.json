{
  "cli": {
    "version": ">= 19.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "preview",
        "EXPO_PUBLIC_DEV_SKIP_ONBOARDING": "false",
        "EXPO_PUBLIC_SKIP_EMAIL_VERIFICATION": "false",
        "EXPO_PUBLIC_API_URL": "http://172.20.10.7:3001",
        "EXPO_PUBLIC_WALLET_URL": "http://172.20.10.7:8082",
        "EXPO_PUBLIC_SOCKET_URL": "http://172.20.10.7:3001"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_DEV_SKIP_ONBOARDING": "false",
        "EXPO_PUBLIC_SKIP_EMAIL_VERIFICATION": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
