{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quilax",
  "version": "1.0.0",
  "identifier": "com.quilax.app",
  "build": {
    "beforeDevCommand": "npm start -- --web",
    "devUrl": "http://localhost:8081",
    "beforeBuildCommand": "npx expo export --platform web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Quilax",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
