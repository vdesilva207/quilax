# Copia a .env / EAS secrets. Nunca commits con secretos reales.

# development | production
APP_ENV=development

# API (sin barra final)
EXPO_PUBLIC_API_URL=http://127.0.0.1:3001

# Wallet / Gestión (app pública)
EXPO_PUBLIC_WALLET_URL=http://127.0.0.1:8082

# Socket.IO (normalmente igual que API)
EXPO_PUBLIC_SOCKET_URL=http://127.0.0.1:3001

# Producción (ejemplo)
# APP_ENV=production
# EXPO_PUBLIC_API_URL=https://api.appquilax.com
# EXPO_PUBLIC_WALLET_URL=https://gestion.appquilax.com
# EXPO_PUBLIC_SOCKET_URL=https://api.appquilax.com
