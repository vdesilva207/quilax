{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quilax Admin",
  "version": "1.0.0",
  "identifier": "com.quilax.admin",
  "build": {
    "beforeDevCommand": "npx expo start --web --port 8083",
    "devUrl": "http://localhost:8083",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Quilax Admin",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
