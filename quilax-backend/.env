# SERVER
PORT=3001
NODE_ENV=development

# HIGH CONCURRENCY SETTINGS
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=60000
UV_THREADPOOL_SIZE=32
NODE_OPTIONS=--max-old-space-size=4096

# DATABASE (PostgreSQL local)
DATABASE_URL=postgresql://imac@localhost:5432/quilax_dev

# REDIS CLUSTER (para producción)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CLUSTER_ENABLED=false
REDIS_NODES=localhost:6379,localhost:6380,localhost:6381
REDIS_PASSWORD=

# AUTH
JWT_SECRET=quilax_secure_jwt_secret_2024_change_in_production_use_32_plus_chars

# ENCRYPTION
ENCRYPTION_KEY=quilax_encryption_key_2024_change_in_production_use_32_plus_chars

# EMAIL
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=hermesdesilvaortiz@gmail.com
