generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int                  @id @default(autoincrement())
  email                 String               @unique
  password              String?
  role                  Role                 @default(USER)
  points                Int                  @default(0)
  balance               Int                  @default(0)
  currency              String               @default("EUR")
  createdAt             DateTime             @default(now())
  quizSubmittedAt       DateTime?            // Cuándo envió el último quiz a revisión
  quizRejectedAt        DateTime?            // Cuándo fue rechazado el último quiz
  fullName              String?              // Nombre completo del usuario
  dateOfBirth           DateTime?            // Fecha de nacimiento
  isOver18              Boolean?             @default(false) // Si es mayor de 18 años
  emailVerificationToken String?             // Token de verificación de email
  twoFactorSecret       String?              // Secreto para Google Authenticator
  twoFactorEnabled      Boolean              @default(false) // Si 2FA está habilitado
  
  // Campos de verificación y KYC
  guardianPhotoUrl      String?              // Foto del tutor (para menores)
  verificationVideoUrl  String?              // Video de verificación
  idDocumentUrl         String?              // URL del documento de identidad
  idDocumentType        String?              // Tipo de documento (DNI, PASSPORT, etc)
  idVerified            Boolean              @default(false) // Si el documento está verificado
  idVerifiedAt          DateTime?            // Cuándo se verificó el documento
  
  // Configuración de privacidad
  profilePublic         Boolean              @default(false) // Si el perfil es público
  showQuizHistory       Boolean              @default(true) // Si mostrar historial de quizzes
  showPrizes            Boolean              @default(true) // Si mostrar premios ganados
  language              String               @default("es") // Idioma preferido del usuario
  
  // Datos bancarios (encriptados)
  isBankVerified        Boolean              @default(false) // Si la cuenta bancaria está verificada
  bankAccountIban       String?              // IBAN encriptado
  bankAccountName       String?              // Nombre del titular encriptado
  bankAccountBic        String?              // BIC/SWIFT encriptado
  
  // Estado del usuario
  isBanned              Boolean              @default(false) // Si el usuario está baneado

  // Relaciones existentes
  sentMessages          Message[]            @relation("SentMessages")
  receivedMessages      Message[]            @relation("ReceivedMessages")
  notifications         Notification[]
  payments              Payment[]
  premium               PremiumSubscription?
  createdQuizzes        Quiz[]               @relation("CreatorQuizzes")
  quizAnswers           QuizAnswer[]
  quizEnrollments       QuizEnrollment[]
  quizParticipants      QuizParticipant[]
  quizScores            QuizScore[]
  quizWinners           QuizWinner[]         @relation("UserQuizWinners")
  seasons               SeasonUser[]
  seasonWinners         SeasonWinner[]       @relation("UserSeasonWinners")
  transactions          Transaction[]        @relation("UserTransactions")
  conversations         Conversation[]       @relation("ConversationParticipants")
  withdrawals           Withdraw[]
  enhancedKyc           EnhancedKyc[]
  supportTickets        SupportTicket[]
  supportMessages       SupportMessage[]
  helpArticles          HelpArticle[] @relation("HelpArticleCreator")
  followers             Follow[] @relation("Followers")
  following             Follow[] @relation("Following")
  quizReports           QuizReport[] @relation("QuizReports")
  adminMessages         AdminMessage[]
  sentAdminMessages    AdminInternalMessage[] @relation("SentAdminMessages")
}

model Season {
  id            Int            @id @default(autoincrement())
  name          String
  color         String?        @default("#6366f1") // Color personalizado para la temporada
  startsAt      DateTime
  endsAt        DateTime
  jackpotPool   Int            @default(0) // Jackpot total de la temporada
  createdAt     DateTime       @default(now())
  users         SeasonUser[]
  seasonWinners SeasonWinner[]
}

model SeasonUser {
  id        Int      @id @default(autoincrement())
  userId    Int
  seasonId  Int
  points    Int      @default(0)
  createdAt DateTime @default(now())
  season    Season   @relation(fields: [seasonId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, seasonId])
}

model SeasonWinner {
  id                Int        @id @default(autoincrement())
  seasonId          Int
  userId            Int
  type              WinnerType
  reward            String?
  position          Int?
  points            Int
  pointsAwarded     Int?
  rewardDescription String?
  creditsAwarded    Int?       // Créditos otorgados del jackpot
  createdAt         DateTime   @default(now())
  season            Season     @relation(fields: [seasonId], references: [id])
  user              User       @relation("UserSeasonWinners", fields: [userId], references: [id])

  @@unique([seasonId, userId])
}

model Quiz {
  id            Int              @id @default(autoincrement())
  title         String
  requestedDate DateTime?
  difficulty    Int?             // Dificultad del 1 al 10
  status        QuizStatus       @default(PENDING_REVIEW)
  credits       Int              @default(0)
  createdAt     DateTime         @default(now())
  creatorId     Int

  creator       User             @relation("CreatorQuizzes", fields: [creatorId], references: [id])
  enrollments   QuizEnrollment[]
  questions     QuizQuestion[]
  quizRuns      QuizRun[]
  schedules     QuizSchedule[]
  winners       QuizWinner[]     @relation("QuizWinners")
  rewardRules   RewardRule[]
  transactions  Transaction[]    @relation("QuizTransactions")
  reports       QuizReport[]
}

model QuizQuestion {
  id         Int          @id @default(autoincrement())
  quizId     Int
  text       String
  maxPoints  Int          @default(1000)
  readTime   Int
  answerTime Int
  answers    QuizAnswer[]
  quiz       Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizEnrollment {
  id        Int      @id @default(autoincrement())
  quizId    Int
  userId    Int
  createdAt DateTime @default(now())
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([quizId, userId])
}

model QuizSchedule {
  id          Int            @id @default(autoincrement())
  quizId      Int
  scheduledAt DateTime
  status      ScheduleStatus @default(RESERVED)
  quiz        Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizWinner {
  id         Int        @id @default(autoincrement())
  quizId     Int
  userId     Int
  percent    Float
  creditsWon Int
  type       WinnerType @default(TOP)
  quizRunId  Int
  createdAt  DateTime   @default(now())
  quiz       Quiz       @relation("QuizWinners", fields: [quizId], references: [id], onDelete: Cascade)
  user       User       @relation("UserQuizWinners", fields: [userId], references: [id])
}

model Payment {
  id                    Int           @id @default(autoincrement())
  userId                Int
  amount                Int
  currency              String        @default("EUR")
  status                PaymentStatus
  stripePaymentIntentId String        @unique
  stripeChargeId       String?       @unique
  creditsPurchased      Int           // Créditos comprados
  paymentType           PaymentType   @default(CREDIT_PURCHASE)
  failureReason         String?       // Razón de fallo si aplica
  createdAt             DateTime      @default(now())
  user                  User          @relation(fields: [userId], references: [id])
}

model PremiumSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  startsAt  DateTime
  endsAt    DateTime
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Transaction {
  id              Int             @id @default(autoincrement())
  userId          Int?
  quizId          Int?
  type            TransactionType
  amount          Int
  currency        String
  createdAt       DateTime        @default(now())
  isSuspicious    Boolean         @default(false)
  suspiciousReason String?
  ipAddress       String?
  quiz            Quiz?           @relation("QuizTransactions", fields: [quizId], references: [id], onDelete: Cascade)
  user            User?           @relation("UserTransactions", fields: [userId], references: [id])
}

model Withdraw {
  id              Int            @id @default(autoincrement())
  userId          Int
  amount          Int
  currency        String         @default("EUR")
  status          WithdrawStatus @default(REQUESTED)
  stripePayoutId String?        @unique
  bankAccountIban String?
  bankAccountName String?
  processingFee   Int             @default(0)
  failureReason   String?
  processedAt     DateTime?
  createdAt       DateTime       @default(now())
  // Para retiros fraccionados
  parentWithdrawId Int?          // ID del retiro principal
  isPartOfSeries   Boolean       @default(false) // Si es parte de una serie de retiros
  seriesIndex      Int?          // Índice en la serie (1, 2, 3...)
  scheduledFor     DateTime?     // Cuándo está programado este retiro
  user            User           @relation(fields: [userId], references: [id])
}

model SystemSettings {
  id                          Int      @id @default(autoincrement())
  maxQuizzesPerMinute         Int      @default(1)
  maxQuizzesPerHour           Int      @default(60)
  defaultMaxPointsPerQuestion Int      @default(1000)
  pointsDecayPerSecond        Int      @default(10)
  // Límites de retiro para evitar problemas bancarios
  maxWithdrawPerMonth         Int      @default(200000) // 200k€ por mes (cuentas verificadas)
  maxWithdrawPerTransaction   Int      @default(50000) // 50k€ por transacción (cuentas verificadas)
  largePrizeThreshold         Int      @default(100000) // 100k€ requiere KYC enhanced
  updatedAt                   DateTime @updatedAt
}

model Message {
  id             Int           @id @default(autoincrement())
  fromUserId     Int
  toUserId       Int
  content        String
  isRead         Boolean       @default(false)
  createdAt      DateTime      @default(now())
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  fromUser       User          @relation("SentMessages", fields: [fromUserId], references: [id])
  toUser         User          @relation("ReceivedMessages", fields: [toUserId], references: [id])
}

model QuizRun {
  id                Int               @id @default(autoincrement())
  quizId            Int
  phase             QuizPhaseType
  currentIndex      Int               @default(0)
  totalPrizeCredits Int               @default(0)
  startedAt         DateTime          @default(now())
  phaseStartedAt    DateTime?
  phaseEndsAt       DateTime?
  finishedAt        DateTime?
  createdAt         DateTime          @default(now())
  participants      QuizParticipant[]
  quiz              Quiz              @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizRunAnswers    QuizRunAnswer[]
  scores            QuizScore[]
}

model QuizParticipant {
  id        Int               @id @default(autoincrement())
  quizRunId Int
  userId    Int
  joinedAt  DateTime          @default(now())
  status    ParticipantStatus @default(ACTIVE)
  score     Int               @default(0)
  quizRun   QuizRun           @relation(fields: [quizRunId], references: [id])
  user      User              @relation(fields: [userId], references: [id])

  @@unique([quizRunId, userId])
}

model QuizScore {
  id           Int       @id @default(autoincrement())
  quizRunId    Int
  userId       Int
  score        Int       @default(0)
  lastAnswerAt DateTime?
  answeredAt   DateTime?
  quizRun      QuizRun   @relation(fields: [quizRunId], references: [id])
  user         User      @relation(fields: [userId], references: [id])

  @@unique([quizRunId, userId])
}

model RewardRule {
  id           Int            @id @default(autoincrement())
  quizId       Int
  type         RewardRuleType
  positionFrom Int?
  positionTo   Int?
  percent      Float
  createdAt    DateTime       @default(now())
  quiz         Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizAnswer {
  id         Int          @id @default(autoincrement())
  questionId Int
  userId     Int?
  isCorrect  Boolean
  text       String
  question   QuizQuestion @relation(fields: [questionId], references: [id])
  user       User?        @relation(fields: [userId], references: [id])
}

model QuizRunAnswer {
  id             Int      @id @default(autoincrement())
  quizRunId      Int
  questionId     Int
  userId         Int
  answer         String
  text           String?
  isCorrect      Boolean
  score          Int
  responseTimeMs Int
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())
  quizRun        QuizRun  @relation(fields: [quizRunId], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  title     String
  body      String
  data      Json?
  uniqueKey String?  @unique
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id])
}

model SupportTicket {
  id          Int              @id @default(autoincrement())
  userId      Int
  category    TicketCategory
  subject     String
  description String
  status      TicketStatus     @default(OPEN)
  priority    TicketPriority   @default(MEDIUM)
  assignedTo  Int?             // Admin asignado
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  closedAt    DateTime?
  user        User             @relation(fields: [userId], references: [id])
  messages    SupportMessage[]
}

model SupportMessage {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  userId    Int
  content   String
  isFromAdmin Boolean @default(false)
  createdAt DateTime @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])
}

model HelpArticle {
  id          Int      @id @default(autoincrement())
  question    String
  answer      String
  category    String
  keywords    String?  // Palabras clave para búsqueda
  views       Int      @default(0)
  helpful     Int      @default(0) // Votos de "útil"
  notHelpful  Int      @default(0) // Votos de "no útil"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   Int      // Admin que lo creó
  creator     User     @relation("HelpArticleCreator", fields: [createdBy], references: [id])
  relatedTickets Int[]  // IDs de tickets relacionados
}

model UserBlock {
  id        Int @id @default(autoincrement())
  blockerId Int
  blockedId Int
}

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())

  follower    User     @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model QuizReport {
  id        Int      @id @default(autoincrement())
  quizId    Int
  reporterId Int
  reason    String
  description String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  reviewedAt DateTime?

  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  reporter  User     @relation("QuizReports", fields: [reporterId], references: [id], onDelete: Cascade)
}

model UserMute {
  id          Int @id @default(autoincrement())
  userId      Int
  mutedUserId Int
}

model Conversation {
  id           String    @id @default(uuid())
  messages     Message[]
  participants User[]    @relation("ConversationParticipants")
}

model EnhancedKyc {
  id           Int           @id @default(autoincrement())
  userId       Int
  documentType KycDocumentType
  documentUrl  String
  status       KycStatus     @default(PENDING)
  verifiedAt   DateTime?
  rejectionReason String?
  createdAt    DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id])
}

enum Role {
  USER
  ADMIN
  ADMIN_WORKER
}

enum QuizStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SCHEDULED
  PUBLISHED
  FINISHED
}

enum QuizDifficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

enum ScheduleStatus {
  RESERVED
  ACTIVE
  COMPLETED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum PaymentType {
  CREDIT_PURCHASE
  PREMIUM_SUBSCRIPTION
  VERIFICATION_FEE
}

enum TransactionType {
  QUIZ_ENTRY
  PRIZE_PAYOUT
  PLATFORM_FEE
  WITHDRAW
}

enum WithdrawStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  REJECTED
}

enum SenderType {
  PLAYER
  ADMIN
}

enum MessageStatus {
  NEW
  READ
  ARCHIVED
}

enum WinnerType {
  TOP
}

enum ParticipantStatus {
  ACTIVE
  DISCONNECTED
  ELIMINATED
  FINISHED
}

enum RewardRuleType {
  POSITION
  CREATOR
  ADMIN
  JACKPOT
}

enum QuizPhaseType {
  PRE_START
  QUESTION_READ
  QUESTION_ANSWER
  QUESTION_CORRECTION
  QUESTION_RANKING
  FINISHED
}

enum KycDocumentType {
  PASSPORT
  INCOME_PROOF
  TAX_ID
  BANK_STATEMENT
  ID_CARD
  DRIVERS_LICENSE
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TicketCategory {
  ACCOUNT
  PAYMENTS
  QUIZZES
  TECHNICAL
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model AdminMessage {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
  recipientType String   @default("ADMIN")
  subject       String
  message       String
  status        String   @default("UNREAD")
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([status])
}

model AdminInternalMessage {
  id        Int      @id @default(autoincrement())
  senderId  Int
  sender    User     @relation("SentAdminMessages", fields: [senderId], references: [id])
  subject   String
  message   String
  createdAt DateTime @default(now())

  @@index([senderId])
}

model AdminAccess {
  id                Int      @id @default(autoincrement())
  secretPassword    String   @unique // Contraseña secreta compartida para acceder al panel admin
  pendingPassword   String?  // Nueva contraseña pendiente de cambio
  changeScheduledAt DateTime? // Fecha programada para el cambio (48 horas después)
  createdBy         Int      @default(1) // ID del admin principal que creó la contraseña
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
