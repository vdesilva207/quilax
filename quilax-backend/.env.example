NODE_ENV=development
PORT=3000

# Comma-separated list. Use explicit origins in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:8081,http://localhost:8081

# Security - USE STRONG SECRETS IN PRODUCTION (32+ characters)
JWT_SECRET=change_me_with_a_long_random_secret_at_least_32_characters
ENCRYPTION_KEY=change_me_with_a_long_random_encryption_key_at_least_32_characters

# Database (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quilax?schema=public

# Redis — use REDIS_URL (Upstash) or host/port/password
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=Quilax <noreply@appquilax.com>

# Stripe (pagos + Identity)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# App URLs (Stripe Identity return + deep links)
FRONTEND_APP_URL=https://appquilax.com
# Wallet web — return/refresh de Stripe Connect Express
WALLET_APP_URL=https://gestion.appquilax.com
# Comma-separated emails allowed to skip KYC in non-strict setups (leave empty in prod)
KYC_SKIP_ALLOWLIST=

# Money compliance
ALLOWED_COUNTRIES=ES,PT,FR,DE,IT,NL,BE,AT,IE,LU
MONEY_REQUIRE_KYC=true
# Local only: skip KYC gate on deposit/withdraw
DEV_SKIP_KYC=false
# Local only: skip geo block
DEV_SKIP_GEO=false

# Season worker (set SEASON_WORKER_ENABLED=0 to disable)
SEASON_WORKER_ENABLED=1
SEASON_WORKER_INTERVAL_MS=300000

# Skip real SMTP in local only (never on Render)
SKIP_EMAIL=false

# Server Configuration
NODE_ENV=development
PORT=3000

# Database Pool Configuration
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=60000

# Node.js Configuration
UV_THREADPOOL_SIZE=32
NODE_OPTIONS=--max-old-space-size=4096

# Scalability Monitoring
METRICS_ENABLED=true
ALERT_THRESHOLDS_CONCURRENT_USERS=10000
ALERT_THRESHOLDS_RESPONSE_TIME=500
ALERT_THRESHOLDS_ERROR_RATE=0.05
